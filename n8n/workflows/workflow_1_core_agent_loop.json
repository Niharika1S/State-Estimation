    },
    "loop-state": {
      "main": [[{ "node": "split-batches", "type": "main", "index": 0 }]]
    },
    "split-batches": {
      "main": [[{ "node": "step-loop", "type": "main", "index": 0 }]]
    },
    "step-loop": {
      "main": [[{ "node": "drift-if", "type": "main", "index": 0 }]]
    },
    "drift-if": {
      "true": [[{ "node": "track-drift", "type": "main", "index": 0 }]],
