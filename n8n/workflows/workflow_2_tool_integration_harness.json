    },
    "split-modules": {
      "main": [[{ "node": "set-module-selection", "type": "main", "index": 0 }]]
    },
    "set-module-selection": {
      "main": [[{ "node": "start-module-session", "type": "main", "index": 0 }]]
    },
    "start-module-session": {
